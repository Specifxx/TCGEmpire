{
  "name": "riftcompare-mobile",
  "version": "1.0.0",
  "private": true,
  "description": "RiftCompare native Android + iOS app (Capacitor shell over riftcompare.com with native AdMob ads, offline handling, deep links and price-drop push).",
  "scripts": {
    "sync": "cap sync",
    "add:android": "cap add android",
    "add:ios": "cap add ios",
    "open:android": "cap open android",
    "open:ios": "cap open ios",
    "run:android": "cap run android",
    "run:ios": "cap run ios",
    "assets": "capacitor-assets generate --iconBackgroundColor '#0a0f1a' --iconBackgroundColorDark '#0a0f1a' --splashBackgroundColor '#0a0f1a' --splashBackgroundColorDark '#0a0f1a' && node scripts/fix-manifest-mime.mjs",
    "build:debug": "cap sync android && cd android && ./gradlew assembleDebug",
    "build:aab": "cap sync android && cd android && ./gradlew bundleRelease",
    "build:apk": "cap sync android && cd android && ./gradlew assembleRelease",
    "clean:android": "cd android && ./gradlew clean"
  },
  "dependencies": {
    "@capacitor-community/admob": "^8.1.0",
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/core": "^8.5.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/network": "^8.0.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.2",
    "typescript": "^5.9.2"
  }
}
