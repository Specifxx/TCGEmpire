<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/AppTheme">
        <!-- Google AdMob application id. Currently Google's official TEST app id
             (safe to ship while developing — shows test ads, never risks the
             account). Replace @string/admob_app_id in res/values/strings.xml
             with the real AdMob app id before release. -->
        <meta-data android:name="com.google.android.gms.ads.APPLICATION_ID" android:value="@string/admob_app_id" />

        <!-- Let AdMob do its heavy init off the UI thread and pre-fetch the
             first request, so the banner does not stall the first paint. -->
        <meta-data android:name="com.google.android.gms.ads.flag.OPTIMIZE_INITIALIZATION" android:value="true" />
        <meta-data android:name="com.google.android.gms.ads.flag.OPTIMIZE_AD_LOADING" android:value="true" />

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Android App Links. With autoVerify, Android fetches
                 https://riftcompare.com/.well-known/assetlinks.json at install
                 time; if this app's signing certificate is listed there, every
                 riftcompare.com link anywhere on the phone opens straight in the
                 app with no disambiguation dialog. Until that file is published
                 verification simply fails and links keep opening in the browser
                 — nothing breaks, the app just isn't the default handler yet.
                 See store/assetlinks.json.template. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="riftcompare.com" />
                <data android:scheme="https" android:host="www.riftcompare.com" />
            </intent-filter>

            <!-- Private scheme, kept for anything that needs to hand control
                 back to the app from outside a browser context. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="@string/custom_url_scheme" />
            </intent-filter>

            <!-- Launcher long-press shortcuts. -->
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- AdMob reads connectivity to decide whether to even attempt a request. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Advertising ID. From targetSdk 33 an app must declare this to read the
         ad id at all; without it the SDK gets a zeroed id and serves only
         non-personalised ads, which measurably lowers revenue. Declaring it
         means the Play Data safety form must say the app collects an
         advertising identifier — store/listing.md's answers already do. -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" />

    <!-- Android 11+ package visibility. Retailer "buy" links leave the app via
         a Custom Tab (@capacitor/browser declares the CustomTabsService query
         itself), but when no Custom-Tabs-capable browser is installed the
         fallback is a plain ACTION_VIEW. Without this <queries> block that
         fallback resolves to nothing and the buy link silently does nothing —
         which is the one tap on this app that earns money. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>
</manifest>
