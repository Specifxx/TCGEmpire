	<string>ca-app-pub-3940256099942544~1458002511</string>
	<!-- App Tracking Transparency: shown before AdMob requests the IDFA. Without
	     a clear purpose string here, iOS rejects the app. We request consent then
	     fall back to non-personalised ads if the user declines. -->
