{
  "name": "tcgempire",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "tsx scripts/adsense-guard.ts && prisma generate && bash scripts/build-db-push.sh && (node -e \"process.exit(process.env.VERCEL_ENV==='preview'&&(process.env.RM3||process.env.DATABASE_URL_2||process.env.DATABASE_URL)?0:1)\" && IMPORT_ONLY_COUNTRY=SG EBAY_REFRESH=false tsx scripts/import-prices.ts || true) && next build",
    "typecheck": "tsc --noEmit",
    "test": "node --env-file=.env.production --import tsx --test tests/*.test.ts",
    "adsense:guard": "tsx scripts/adsense-guard.ts",
    "adsense:audit": "tsx scripts/adsense-audit.ts",
    "crawl:check": "tsx scripts/crawl-check.ts",
    "status:check": "tsx scripts/status-check.ts",
    "adsense:verify": "tsx scripts/adsense-verify.ts",
    "mobile:check": "tsx scripts/mobile-check.ts",
    "start": "next start",
    "grant:early": "tsx scripts/grant-early-premium.ts",
    "cards:sync": "tsx scripts/sync-cards.ts",
    "cards:manual": "tsx scripts/add-manual-cards.ts",
    "cards:tcg-printings": "tsx scripts/add-tcg-printings.ts",
    "cards:fix-cloned-art": "tsx scripts/fetch-official-images.ts && tsx scripts/fix-cloned-art.ts",
    "cards:fetch-vendetta": "tsx scripts/fetch-vendetta-official.ts",
    "cards:import-vendetta": "tsx scripts/import-vendetta.ts",
    "import:prices": "tsx scripts/import-prices.ts",
    "lint": "next lint",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma db push --force-reset && tsx prisma/seed.ts",
    "setup": "prisma generate && prisma db push && tsx prisma/seed.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.102.0",
    "@capacitor-community/admob": "^6.2.0",
    "@capacitor/app": "^6.0.3",
    "@capacitor/browser": "^6.0.6",
    "@capacitor/core": "^6.2.1",
    "@capacitor/status-bar": "^6.0.3",
    "@prisma/client": "^5.22.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "bcryptjs": "^2.4.3",
    "jose": "^5.9.6",
    "next": "^14.2.35",
    "nextjs-toploader": "^3.9.17",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "stripe": "^17.7.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.35",
    "jimp": "^1.6.1",
    "postcss": "^8.5.15",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.6",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3"
  }
}
