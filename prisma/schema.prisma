// TCGEmpire — Riftbound marketplace database schema
// SQLite for local MVP. Enums are represented as Strings because the SQLite
// connector does not support native enums; allowed values are validated in app code.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String    @id @default(cuid())
  email               String    @unique
  // Optional — accounts created via Google/Discord sign-in have no password.
  passwordHash        String?
  displayName         String
  avatarUrl           String?
  // Set when the email is confirmed (instantly for OAuth, which is pre-verified).
  emailVerified       DateTime?
  // OAuth identities (one per provider). Lets a user link Google and/or Discord.
  // Indexed (not DB-unique) so the push stays additive; uniqueness is enforced in
  // the OAuth callback (we find-or-create by provider id, then by email).
  googleId            String?
  discordId           String?
  // Wallet balance in AUD cents (e.g. 25000 = $250.00).
  // Funds committed to open buy orders are moved out of balance and held as
  // escrow on the BuyOrder (reservedCents) until the order fills or is cancelled.
  balanceCents        Int       @default(0)
  isAdmin             Boolean   @default(false)
  // Verified sellers may list cards in the RiftCompare marketplace (see /marketplace).
  isVerifiedSeller    Boolean   @default(false)
  // ── RiftCompare Premium (Stripe subscription) ──
  // premiumUntil = end of the current paid period (renewals extend it via webhook;
  // a lapsed/cancelled sub simply stops extending). stripeCustomerId links renewal
  // invoices back to the account.
  premiumUntil        DateTime?
  stripeCustomerId    String?
  // Set the first time this account starts a free trial → one trial per account
  // (a returning user just subscribes, no second trial).
  trialStartedAt      DateTime?
  // Set once when the early-adopter "first 100 users get Premium" comp is granted,
  // so the grant is idempotent (never re-granted / re-extended on re-runs).
  earlyPremiumGranted Boolean   @default(false)
  createdAt           DateTime  @default(now())

  // The market (AU/NZ/US/UK/SG/CA) this account browses/prices in, remembered
  // across devices and sign-ins. Null until the account's first resolved
  // country (cookie or geo-detected) is backfilled, or the user explicitly
  // switches markets while signed in (see CountryProvider + POST
  // /api/account/country). Exists because IP-geo detection (x-vercel-ip-country)
  // is unreliable once traffic is proxied through a third-party CDN in front of
  // Vercel (e.g. Ezoic) — a signed-in visitor should still land on their real
  // market even when the geo header no longer reflects their true location.
  preferredCountry    String?

  // ── Saved default shipping address (marketplace checkout) ─────────────────────
  // Prefills the checkout address step; a fresh snapshot is copied onto each Order
  // at purchase time (see Order.ship* below) so editing this later never rewrites
  // history for past orders. country is NOT user-chosen at checkout (always the
  // listing's own market — same-region-only), but is kept here so a saved address
  // prefills sensibly the next time.
  shipName     String?
  shipLine1    String?
  shipLine2    String?
  shipCity     String?
  shipRegion   String? // state/province/county — free text
  shipPostcode String?
  shipCountry  String?
  shipPhone    String?

  listings            Listing[]
  buyOrders           BuyOrder[]
  purchases           Order[]              @relation("BuyerOrders")
  sales               Order[]              @relation("SellerOrders")
  notifications       Notification[]
  authTokens          AuthToken[]
  sellerProfile       SellerProfile?
  marketplaceListings MarketplaceListing[]
  collection          CollectionCard[]
  gameScores          GameScore[]
  offersMade          MarketplaceOffer[]   @relation("OffersMade")
  offersReceived      MarketplaceOffer[]   @relation("OffersReceived")
  reviewsWritten      MarketplaceReview[]  @relation("ReviewsWritten")
  reviewsReceived     MarketplaceReview[]  @relation("ReviewsReceived")
  sentOrderMessages   OrderMessage[]
  priceAlerts         PriceAlert[]

  @@index([googleId])
  @@index([discordId])
  @@index([stripeCustomerId])
}

// Anti-abuse ledger for the Premium free trial. Stripe assigns every card a stable
// `fingerprint` that is the SAME across different customers/accounts, so recording
// it here lets us refuse a second free trial for a card that's already had one —
// defeating "make a new account, trial again" abuse. A blocked card can still
// subscribe (paid), it just doesn't get another free trial.
model TrialRedemption {
  id              String   @id @default(cuid())
  cardFingerprint String   @unique
  userId          String
  createdAt       DateTime @default(now())

  @@index([userId])
}

// A store on the B2B repricer programme: each partner store gets a secret token
// that unlocks /stores/report — a live "your prices vs the market" dashboard for
// THEIR retailer key. Created by an admin (see /api/admin/store-partners).
model StorePartner {
  id        String   @id @default(cuid())
  retailer  String // the store's RetailerPrice key, e.g. "cherry"
  name      String // display name for the report header
  token     String   @unique // secret access token (capability URL)
  createdAt DateTime @default(now())

  @@index([retailer])
}

// An auto-generated daily market report (AFR-style "market wrap" for the Riftbound
// singles market). One per calendar day, written by /api/cron/market-report at
// Wall St pre-market open and surfaced in the blog alongside the editorial posts.
model MarketReport {
  id              String   @id @default(cuid())
  slug            String   @unique // riftbound-market-report-YYYY-MM-DD
  day             String   @unique // YYYY-MM-DD (Australia/Sydney), one report per day
  title           String
  excerpt         String
  body            String // markdown
  // Snapshot the headline numbers so we can render cards/sitemap without recompute.
  globalChangePct Float?
  // Structured chart payload (ReportData in lib/market-report.ts): index series,
  // per-region stats/sparklines, breadth, movers and prose sections — everything
  // the rich article view needs to draw its diagrams without recomputing.
  data            Json?
  createdAt       DateTime @default(now())

  @@index([createdAt])
}

// A player's best score in an arcade mini-game (/games/*). One row per user per
// game — a better result replaces it. Whether higher or lower wins is per-game
// (see lib/games.ts) and applied in app code, so `score` is stored raw with an
// optional tiebreak (e.g. Pairs clear time) in `meta`.
model GameScore {
  id        String   @id @default(cuid())
  userId    String
  game      String // "higher-lower" | "price-check" | "zoomed" | "pairs"
  score     Int
  meta      Json? // e.g. { seconds } for the Pairs tiebreak
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, game])
  @@index([game, score])
}

// One-time tokens for email verification and password reset (purpose-tagged).
model AuthToken {
  id        String   @id @default(cuid())
  token     String   @unique
  purpose   String // "verify" | "reset"
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// In-app notification center — one row per lifecycle event a user should see
// (order sold/purchased/shipped/completed/cancelled, etc; see lib/notifications.ts
// for the single createNotification() call site every trigger goes through).
// Bounded per-user reads only (see api/notifications/route.ts); nothing here is
// ever queried without a userId + take limit.
model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String // e.g. "order_shipped", "order_sold" — informational only, not branching logic
  title     String
  body      String
  href      String? // where clicking the notification navigates to
  readAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

model Card {
  id                 String    @id @default(cuid())
  externalId         String?   @unique // RiftScribe id, e.g. "ogn-001-298"
  slug               String?   @unique // human-readable URL, e.g. "vayne-hunter-sfd-223s-221"
  name               String
  // Lowercased, punctuation-stripped name for apostrophe-tolerant search.
  nameNormalized     String    @default("")
  setCode            String // e.g. "OGN"
  setName            String // e.g. "Origins"
  collectorNumber    String // e.g. "001/298"
  // One of the Riftbound domains: Fury, Calm, Mind, Body, Chaos, Order, Colorless
  domain             String
  // Unit, Spell, Gear, Rune, Battlefield, Legend
  type               String
  // Common, Uncommon, Rare, Epic, Showcase
  rarity             String
  // Alt-art / variant suffix from the card number, e.g. "a" for 112a. null = base art.
  variant            String?
  // Collector number beyond the set total (e.g. 197/166), excluding signatures.
  // Denormalised (SQL can't compare the two halves of the number string) — set by
  // the importers and backfilled idempotently on every deploy (fix-altart-rarity).
  isOvernumbered     Boolean   @default(false)
  // Promo printing (prerelease / organized-play). Shares the base card's art.
  isPromo            Boolean   @default(false)
  orientation        String? // portrait | landscape
  energyCost         Int?
  might              Int?
  power              Int?
  tags               String? // comma-separated keyword tags
  description        String?
  flavorText         String?
  // Real card images (RiftScribe CDN). Falls back to generated SVG art if null.
  imageUrl           String? // full-resolution
  imageThumbUrl      String? // smaller webp for grids
  blurDataUrl        String? // tiny base64 placeholder
  imageHash          String? // 64-bit perceptual dHash (hex) of the card image, for the camera scanner
  // Reference / market price in AUD cents, used as a default suggested price.
  marketPriceCents   Int       @default(0)
  // Lowest live retailer price across all sources, set by the price importer.
  // Used for "from $X" and catalogue sorting. null = no price found.
  //   lowestPriceCents   = Australia (AUD cents), from AU stores + eBay AU
  //   lowestPriceCentsNz = New Zealand (NZD cents), from NZ stores (no eBay)
  //   lowestPriceCentsUs = United States (USD cents), from US stores + eBay US
  //   lowestPriceCentsUk = United Kingdom (GBP cents), from UK stores + eBay UK + TCGplayer
  //   lowestPriceCentsSg = Singapore (SGD cents), from SG stores + eBay SG
  //   lowestPriceCentsCa = Canada (CAD cents), from CA stores + eBay CA
  lowestPriceCents   Int?
  lowestPriceCentsNz Int?
  lowestPriceCentsUs Int?
  lowestPriceCentsUk Int?
  lowestPriceCentsSg Int?
  // Nullable with no default, like every other market column above, so
  // `prisma db push` adds it additively to the live table with no backfill and
  // no data loss (see the build script — it db-pushes on deploy). Populated on
  // the next price import; null everywhere until then, which every read path
  // already handles as "no price yet".
  lowestPriceCentsCa Int?
  artSeed            Int       @default(0)
  // Popularity signals. searchCount (clicks from the search box) is the purer demand
  // metric and drives eBay prioritisation; viewCount (any open, incl. featured
  // homepage clicks) is kept for general "trending" use.
  viewCount          Int       @default(0)
  searchCount        Int       @default(0)
  lastViewedAt       DateTime?
  // Last time the eBay pass actually QUERIED this card. If a card has no eBay
  // listing and this is stale/null, the pass never reached it (budget/quota ran
  // out) → the card page offers a "search eBay" affiliate link instead.
  ebayCheckedAt      DateTime?
  createdAt          DateTime  @default(now())

  listings            Listing[]
  buyOrders           BuyOrder[]
  retailerPrices      RetailerPrice[]
  priceHistory        PriceHistory[]
  demandSnapshots     DemandSnapshot[]
  priceAlerts         PriceAlert[]
  marketplaceListings MarketplaceListing[]
  collectedBy         CollectionCard[]
  ebayAdListings      EbayAdListing[]
  ebayAuctions        EbayAuction[]
  ebayGradedListings  EbayGradedListing[]

  @@index([setCode, collectorNumber])
  @@index([nameNormalized])
  @@index([lowestPriceCents])
  @@index([lowestPriceCentsNz])
  @@index([lowestPriceCentsUs])
  @@index([lowestPriceCentsUk])
  // Sg had no index (every other market did) — added with Ca, since the homepage
  // runs one `count({ where: { <priceField>: { not: null } } })` per market and the
  // browse grid sorts on it, so SG was doing sequential scans for both.
  @@index([lowestPriceCentsSg])
  @@index([lowestPriceCentsCa])
  @@index([domain])
  @@index([rarity])
  @@index([type])
}

// A seller's offer to sell (the "ask" side of the book).
model Listing {
  id         String   @id @default(cuid())
  cardId     String
  sellerId   String
  condition  String // NM, LP, MP, HP, DMG
  isFoil     Boolean  @default(false)
  priceCents Int
  quantity   Int      @default(1)
  status     String   @default("ACTIVE") // ACTIVE, SOLD, CANCELLED
  createdAt  DateTime @default(now())

  card   Card    @relation(fields: [cardId], references: [id], onDelete: Cascade)
  seller User    @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([cardId])
  @@index([sellerId])
  @@index([status])
  @@index([priceCents])
}

// A buyer's standing request to buy (the "bid" side of the book). Lets demand
// exist even when there is zero stock — any seller can fill it.
model BuyOrder {
  id             String   @id @default(cuid())
  cardId         String
  buyerId        String
  condition      String // desired condition: NM, LP, MP, HP, DMG, or ANY
  isFoil         Boolean  @default(false)
  maxPriceCents  Int // bid price the buyer will pay per copy
  quantity       Int      @default(1)
  quantityFilled Int      @default(0)
  reservedCents  Int      @default(0) // escrowed funds still held for unfilled copies
  status         String   @default("OPEN") // OPEN, FILLED, CANCELLED
  createdAt      DateTime @default(now())

  card  Card    @relation(fields: [cardId], references: [id], onDelete: Cascade)
  buyer User    @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  fills Order[]

  @@index([cardId])
  @@index([buyerId])
  @@index([status])
  @@index([maxPriceCents])
}

// Legacy table from the retired password-reset feature. The feature (pages, API
// routes, UI) was removed, but the table is kept so its data isn't dropped; nothing
// in the app references this model anymore.
model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// Feedback / contact-form submissions. Saved here as a backup and forwarded by
// email to the site owner.
model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String?
  message   String
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// Feedback / reviews submitted from anywhere on the site. Kept as its own model
// (not ContactMessage) so we can tie it to an account when there is one and track
// the Premium reward.
//
// userId IS NULLABLE, and that is the whole point. It was REQUIRED until
// 2026-08-14, which meant /api/feedback 401'd anyone signed out and
// components/FeedbackForm.tsx rendered a "Sign in →" wall instead of a form. So
// the only people who could tell us the site was hard to use were the people who
// had already committed to an account — precisely the wrong sample, and the
// reason this table stayed near-empty. Anonymous rows carry userId: null; a
// signed-in submission still records the account (and still earns the one-time
// Premium grant, which anonymous submissions cannot — there is no account to
// grant it to).
model Feedback {
  id        String   @id @default(cuid())
  userId    String? // null = submitted by a signed-out visitor
  message   String
  rating    Int? // optional 1–5 star rating
  createdAt DateTime @default(now())

  // Optional reply address for signed-out submitters. NEVER rendered publicly —
  // it exists so a real complaint can get a real answer. Signed-in rows leave it
  // null (the account already has an address).
  email String?
  // What the submitter wants to be called IF they consented to publication.
  // Free text, moderated before it is ever shown.
  displayName String?
  // Where the feedback came from, so a complaint can be read in context: the
  // path ("/card/foo") and which surface raised it.
  page   String?
  source String @default("page") // page | widget | riftle

  // MODERATION. Nothing reaches a public surface on submission — status starts
  // NEW and an admin must move it to APPROVED. consentPublic records whether the
  // submitter actually ticked "you can show this publicly"; BOTH are required
  // before display (see lib/reviews.ts). Publishing someone's words because they
  // happened to be positive, without asking, is not something to leave possible
  // by accident.
  status        String    @default("NEW") // NEW | APPROVED | HIDDEN | SPAM
  consentPublic Boolean   @default(false)
  publishedAt   DateTime?

  @@index([createdAt])
  @@index([userId])
  // Serves the public "approved reviews" read without scanning the table.
  @@index([status, publishedAt])
}

// A "clicked Premium" intent event — someone opened the Premium upsell dialog or
// started checkout. Lets us see interest (and who) before/independent of conversion.
// userId is null for logged-out visitors. Low volume, so it lives in the main DB.
model PremiumClick {
  id        String   @id @default(cuid())
  userId    String? // null = not signed in
  source    String   @default("dialog") // dialog | checkout | premium-page | button
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([userId])
}

// A store submitted via the public "Suggest a store" form. Low-volume operational
// data (reviewed by hand, then added to src/lib/retailers.ts), so it lives in the
// main DB rather than the write-heavy history DB. status: pending | added | rejected.
model StoreSuggestion {
  id        String   @id @default(cuid())
  storeName String
  storeUrl  String
  country   String   @default("AU") // AU | NZ | US | UK | OTHER
  email     String? // optional submitter email (for follow-up)
  note      String? // optional message from the submitter
  status    String   @default("pending")
  ip        String? // best-effort, for abuse triage only
  createdAt DateTime @default(now())

  @@index([status, createdAt])
}

// Daily snapshot of a card's lowest live price, for the price-over-time chart
// (CSFloat-style). Written by the importer: at most one row per card per
// Australia/Sydney day — a same-day re-run (e.g. a deploy) replaces that day's
// value. Collected in the backend now; the chart ships once a week+ exists.
model PriceHistory {
  id               String   @id @default(cuid())
  cardId           String
  // Market this point is for (AU/NZ/US/UK); each market is priced in its own currency.
  country          String   @default("AU")
  // Calendar day in Australia/Sydney (stored date-only), the chart's x-axis.
  day              DateTime @db.Date
  lowestPriceCents Int
  recordedAt       DateTime @default(now())

  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@unique([cardId, country, day])
  @@index([cardId, country, day])
  // Serves the Price Watch movers query (all cards in one market over a window).
  @@index([country, day])
}

// Daily snapshot of a card's cumulative demand counters (searchCount/viewCount),
// mirroring PriceHistory. searchCount/viewCount on Card are running totals with no
// history, so this is the ONLY way to measure demand VELOCITY (rising interest) —
// the leading signal for a near-future price rise. Written by the importer: one row
// per card per Australia/Sydney day (a same-day re-run replaces it). Country-agnostic
// (search/view demand isn't per-market). The rise predictor's velocity component
// activates automatically once a few days of snapshots exist.
model DemandSnapshot {
  id          String   @id @default(cuid())
  cardId      String
  day         DateTime @db.Date // Australia/Sydney calendar day
  searchCount Int
  viewCount   Int
  recordedAt  DateTime @default(now())

  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@unique([cardId, day])
  @@index([day])
  @@index([cardId, day])
}

// An email subscription for wishlist price-drop alerts. No account required — the
// pop-up on the wishlist heart collects an email and creates one row per card per
// market. A daily cron (/api/cron/price-alerts) compares each card's current
// lowest price for that market against lastPriceCents; when it falls, the
// subscriber is emailed and the new (lower) baseline is recorded so the same drop
// is never notified twice. lastPriceCents also tracks rises so a later dip is
// measured against the most recent price, not a stale one.
model PriceAlert {
  id             String    @id @default(cuid())
  // Lowercased, trimmed recipient address. STILL the mail-routing key and STILL
  // the dedupe key after the user-account migration: a signed-in watch is written
  // with the account's own email, so @@unique([email, cardId, market]) below keeps
  // deduping for accounts exactly as it did for anonymous subscribers, and the
  // drop cron in lib/price-alerts.ts needed no change at all. Safe to keep
  // denormalised because User.email is never updated in-app — the only
  // prisma.user.update touching an email field is api/auth/verify (emailVerified).
  email          String
  // The account that owns this watch, when there is one.
  //
  // NULLABLE with no default, deliberately. The feature shipped account-free
  // ("No account needed" — PriceAlertModal), so most live rows have no account to
  // point at, and a required column could not be added by the `prisma db push`
  // that runs on every deploy. NULL means "an email-only subscriber from the
  // pop-up", and every read path treats it as such: the drop cron ignores this
  // column entirely, and only the account-scoped watchlist routes filter on it.
  userId         String?
  cardId         String
  market         String    @default("AU") // AU | NZ | US | UK | SG | CA
  // Last lowest price observed for this card+market (the baseline a drop is
  // measured against). null until the card first has a price in this market.
  lastPriceCents Int?
  // Per-email secret powering one-click unsubscribe (shared across all of an
  // email's rows, so one link can remove every alert for that address).
  unsubToken     String
  createdAt      DateTime  @default(now())
  // When we last emailed this subscriber about a drop on this card.
  lastNotifiedAt DateTime?

  card Card  @relation(fields: [cardId], references: [id], onDelete: Cascade)
  // Cascade, matching every other User relation in this schema. A price watch is
  // an opt-IN and should die with the account — the inverse of AnnouncementOptOut,
  // which is deliberately email-keyed so an opt-OUT survives deletion. Rows with
  // userId = NULL (every anonymous subscriber) are structurally untouched by a
  // cascade, since it only matches rows carrying the deleted user's id.
  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([email, cardId, market])
  @@index([cardId])
  @@index([email])
  @@index([unsubToken])
  @@index([userId])
}

// A live price for a card at an external retailer, used for price comparison.
// Populated by scripts/import-prices.ts from AU store feeds (Shopify products.json).
model RetailerPrice {
  id            String   @id @default(cuid())
  cardId        String
  retailer      String // store key, e.g. "cherry", "ozzie"
  retailerName  String // display name, e.g. "Cherry Collectables"
  title         String // original product title at the retailer
  url           String // outbound product link (affiliate-ready)
  condition     String? // e.g. "Near Mint" where the retailer specifies it
  isFoil        Boolean  @default(false)
  priceCents    Int
  // Actual shipping for this listing where the source provides it (e.g. eBay).
  // null = use the per-store flat estimate instead.
  shippingCents Int?
  currency      String   @default("AUD")
  inStock       Boolean  @default(true)
  lastSeen      DateTime @default(now())

  // Market: "AU" (Australian stores + eBay AU, AUD) or "NZ" (NZ stores, NZD).
  country String @default("AU")

  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)

  // eBay uses a per-market retailer key ("ebay" = AU, "ebay_us" = US) so the same
  // card can have a listing in each marketplace without colliding on this key.
  @@unique([cardId, retailer, condition, isFoil])
  @@index([cardId])
  @@index([retailer])
  @@index([priceCents])
  @@index([cardId, country, inStock])
}

// A small cache of real eBay listings per card, used to render a native-style
// "eBay Ad" carousel on the card page (real thumbnail/title/price, not a plain
// search link) — see components/EbayAdCarousel.tsx. Captured as a side effect
// of the existing per-card eBay Browse API call in price-import.ts: that call
// already fetches + filters up to 100 results down to the single cheapest
// (RetailerPrice's "ebay" row); this just persists the next few from that SAME
// response, so it costs zero additional Browse API calls/quota.
// A LIVE eBay AUCTION on a chase-tier card.
//
// DELIBERATELY NOT A RetailerPrice ROW, and this is the whole design.
// A current bid is not a price you can pay: a $12 bid on a $180 Signature would
// sort to the top of the comparison table, become the card's "cheapest price",
// and then propagate — lowestPriceCents feeds price history, the market index,
// price alerts, the rise predictor, meta-deck build costs, Today's Top Deals,
// the screener, the sitemap and the Product/Offer JSON-LD Google reads. One
// auction row in the wrong table corrupts all of it and publishes a false price.
// A separate table cannot make that mistake; a shared one only avoids it for as
// long as everyone remembers to filter.
//
// Rows are replaced per market on each auction pass and are USELESS ONCE STALE —
// an ended auction still carrying a live affiliate link is worse than showing
// nothing, exactly as EbayAdListing's MAX_AGE_HOURS note argues. `endsAt` is
// stored so both the reader and the renderer can enforce that independently.
// A GRADED (slabbed) eBay listing for a chase card — PSA / BGS / CGC / SGC.
//
// Its own table for the same reason EbayAuction has one: a slab is genuinely
// this card but is NOT comparable to a raw copy. It trades far above one, and
// the price search excludes it precisely because it kept leaking in as a wrong
// "cheapest" (see GRADED_SLAB in lib/ebay.ts). Keeping slabs out of
// RetailerPrice is what stops that price reaching lowestPriceCents — and from
// there price history, the market index, price alerts, the rise predictor and
// the Product/Offer JSON-LD.
//
// Captured for FREE from the same Browse call the price refresh already makes
// for these cards (searchEbayLowest's captureGraded), so this costs no extra
// quota: the API never filtered graded out, we did, client-side.
//
// No endsAt — a fixed-price listing does not expire on a clock, it simply sells.
// Freshness is therefore by age: rows not refreshed within MAX_AGE_HOURS are not
// served, and the importer's sweep removes ones that stop coming back.
model EbayGradedListing {
  id            String   @id @default(cuid())
  cardId        String
  country       String // marketplace the search ran against
  itemId        String // eBay listing id — stable across refreshes
  priceCents    Int
  shippingCents Int?
  currency      String
  url           String // affiliate-tagged
  title         String
  imageUrl      String?
  // Parsed from the title. `grader` is null only when a slab word matched but no
  // number followed it (e.g. "PSA graded") — the listing is still genuinely
  // graded, we just cannot say to what, and the UI says so rather than guessing.
  grader        String? // "PSA" | "BGS" | "CGC" | "SGC"
  grade         Float? // 10, 9.5, 9, …
  updatedAt     DateTime @updatedAt

  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@unique([itemId, country])
  @@index([cardId, country])
}

model EbayAuction {
  id              String   @id @default(cuid())
  cardId          String
  country         String // marketplace the search ran against (US/AU/UK/SG)
  // eBay's own listing id — stable identity for a listing across passes, so a
  // re-import of the same auction updates rather than duplicating it.
  itemId          String
  currentBidCents Int
  bidCount        Int      @default(0)
  // Auctions may also carry a Buy It Now. Kept because "bid $92, or take it now
  // for $150" is a materially different decision from a bare auction.
  buyItNowCents   Int?
  currency        String
  endsAt          DateTime
  url             String // affiliate-tagged
  title           String
  imageUrl        String?
  condition       String?
  // Graded slabs (PSA/BGS/CGC/SGC) are the category our store comparison
  // structurally cannot cover — no tracked Shopify store lists them — so this
  // flags the listings where eBay is the only market that exists.
  isGraded        Boolean  @default(false)
  updatedAt       DateTime @updatedAt

  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@unique([itemId, country])
  @@index([cardId, country])
  // Drives the "ending soon" reads: next-to-close first, within one market.
  @@index([country, endsAt])
}

model EbayAdListing {
  id            String   @id @default(cuid())
  cardId        String
  country       String   @default("AU") // marketplace the search ran against
  rank          Int // 0 = cheapest shown first, etc.
  priceCents    Int
  shippingCents Int? // null = unknown; 0 = free shipping (shown as a badge)
  currency      String   @default("AUD")
  url           String // affiliate-tagged
  title         String
  imageUrl      String?
  updatedAt     DateTime @updatedAt

  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@unique([cardId, country, rank])
  @@index([cardId, country])
}

// Sealed / non-single Riftbound products (booster boxes, packs, Proving Grounds,
// bundles, …). One row per store listing; the /sealed page groups by groupKey to
// show the cheapest price per product across stores.
model SealedListing {
  id           String   @id @default(cuid())
  groupKey     String // normalised product identity for cross-store grouping
  title        String
  productType  String // "Booster Box", "Booster Pack", "Bundle", "Proving Grounds", …
  setCode      String? // OGN/SFD/UNL/OGS/VEN if detectable
  retailer     String
  retailerName String
  priceCents   Int
  url          String
  imageUrl     String?
  inStock      Boolean  @default(true)
  // Market this listing belongs to, and — since there is no currency column —
  // the currency its priceCents is denominated in: AU/AUD, NZ/NZD, US/USD,
  // UK/GBP, SG/SGD, CA/CAD. (The comment here used to name only AU and NZ; the
  // other four have been written for some time, and eBay now writes per-market
  // rows too rather than AU-only.)
  country      String   @default("AU")
  lastSeen     DateTime @default(now())

  @@index([groupKey])
  @@index([retailer])
  @@index([country])
}

// A completed trade. Either a buyer hit a listing (kind LISTING) or a seller
// filled a buy order (kind BUYORDER).
model Order {
  id                   String    @id @default(cuid())
  kind                 String    @default("LISTING") // LISTING | BUYORDER | MARKETPLACE
  listingId            String?
  buyOrderId           String?
  // Marketplace purchases reference a MarketplaceListing (soft link, no relation).
  marketplaceListingId String?
  buyerId              String
  sellerId             String
  quantity             Int       @default(1)
  totalCents           Int
  // Payment/fulfilment state. Wallet orders settle instantly (PAID);
  // Stripe-checkout orders start PENDING (stock reserved) and flip to PAID via the
  // webhook, or CANCELLED if the session expires / payment fails (stock released).
  status               String    @default("PAID") // PENDING | PAID | CANCELLED | REFUNDED
  shippingCents        Int       @default(0)
  feeCents             Int       @default(0)
  stripeSessionId      String?
  stripePaymentIntent  String?
  reservedUntil        DateTime? // while PENDING, the stock-reservation expiry
  // Marketplace fulfilment: seller marks shipped (-> SHIPPED, with an optional
  // tracking note), buyer confirms delivery (-> COMPLETED). Reviews unlock at SHIPPED.
  shippedAt            DateTime?
  trackingNote         String?
  receivedAt           DateTime?
  createdAt            DateTime  @default(now())

  // ── P2P marketplace additions (Stripe Connect escrow) ──────────────────────────
  // Official order number (RC-<n>), assigned via the Counter table at checkout time.
  // Nullable so legacy pre-existing rows never block `prisma db push` — never make
  // this required.
  orderNumber      Int?      @unique
  // Charge/transfer currency (from the listing at purchase time; AUD/GBP/USD).
  currency         String    @default("AUD")
  // Set by the Stripe webhook when the order flips PAID — anchors the ship-deadline
  // cron job (paidAt + MARKETPLACE_SHIP_DEADLINE_DAYS).
  paidAt           DateTime?
  // Structured tracking (carrier + number) — see lib/tracking.ts for deep-links.
  // trackingNote above stays as free-text for any pre-Connect / non-standard case.
  carrier          String? // AUSPOST | ROYALMAIL | USPS | OTHER
  trackingNumber   String?
  // Stripe Connect payout: set once releaseFundsForOrder() successfully transfers
  // the seller's share out of the platform's held balance.
  stripeTransferId String?
  transferredAt    DateTime?
  refundedAt       DateTime?
  // Who/what triggered the refund — SELLER (seller-initiated, see connect.ts's
  // refundOrderBySeller), BUYER/ADMIN (mutual-cancel or admin force-refund, both
  // already existed before this field), or AUTO (ship-deadline cron). Nullable so
  // the two refund paths that predate this field never need a backfill.
  refundedBy       String?
  // Free-text reason the seller (or admin) gave for the refund — shown to the
  // buyer and kept for support/dispute records. Not required: a seller can refund
  // without explaining why, same as the existing cancel-request flow allows.
  refundReason     String?
  // A support ticket was opened against this order (see SupportTicket.orderId) —
  // blocks the auto-release cron job until an admin resolves it.
  disputedAt       DateTime?
  // Cron-email dedupe stamps (the only lifecycle facts that can't be computed):
  // set when the T-24h "ship soon" seller reminder / the "has it arrived?" buyer
  // nudge was sent, so 6-hourly cron re-runs never double-email an order.
  shipReminderAt   DateTime?
  deliveryNudgeAt  DateTime?

  // ── Fund release (system-driven) ───────────────────────────────────────────
  // A seller confirming their OWN delivery is a conflict of interest, so it's
  // not a release trigger (see api/marketplace/orders/[id]/route.ts). Release
  // happens via: the BUYER confirming (instant), or the auto-release cron on a
  // fixed, buyer-visible date (shippedAt + MARKETPLACE_AUTO_RELEASE_DAYS) unless
  // disputedAt pauses it. Admins handle exceptions only (early-release requests,
  // stale shipments, disputes) — they can force-release, but are not a gate.
  releaseRequestedAt DateTime? // seller asked for early release: "I believe this delivered, please check"
  adminReviewedAt    DateTime? // an admin looked at tracking (audit trail; no longer delays auto-release)
  adminReviewedBy    String? // admin email, for the audit trail
  releasedBy         String? // BUYER | ADMIN | AUTO — who/what actually triggered release

  // ── Mutual-agreement cancellation ──────────────────────────────────────────
  // Either party can propose cancelling a PAID/SHIPPED order; it only actually
  // cancels + fully refunds once the OTHER party accepts (no admin gate needed —
  // both sides consenting removes the conflict-of-interest concern that gates
  // delivery confirmation). cancelRequestedAt is the "pending" signal; cleared on
  // decline/withdraw, left set (order moves to CANCELLED) on accept.
  cancelRequestedBy String? // userId of whoever proposed it
  cancelRequestedAt DateTime?
  cancelReason      String?

  // Shipping address snapshot, captured at checkout (never trust/re-read the
  // buyer's live saved address for an existing order — they might edit or clear
  // it later). country is always the listing's own market, not buyer-chosen.
  shipName     String?
  shipLine1    String?
  shipLine2    String?
  shipCity     String?
  shipRegion   String?
  shipPostcode String?
  shipCountry  String?
  shipPhone    String?

  review   MarketplaceReview?
  messages OrderMessage[]

  listing  Listing?  @relation(fields: [listingId], references: [id])
  buyOrder BuyOrder? @relation(fields: [buyOrderId], references: [id])
  buyer    User      @relation("BuyerOrders", fields: [buyerId], references: [id])
  seller   User      @relation("SellerOrders", fields: [sellerId], references: [id])

  @@index([buyerId])
  @@index([sellerId])
  @@index([stripeSessionId])
  @@index([status])
  @@index([sellerId, status]) // funds dashboard (pending/released aggregates)
  @@index([kind, status, shippedAt]) // cron: auto-release scan
  @@index([kind, status, paidAt]) // cron: ship-deadline scan
}

// A message between the buyer and seller of a marketplace order — scoped to a
// real transaction (not pre-purchase listing questions). Threaded per PARCEL:
// every message stores the id of one anchor Order row shared by the whole
// group (the alphabetically-first order id among a checkout+seller's rows —
// see parcelKey()/groupKey in the maintenance cron and MarketplaceOrders.tsx),
// so a multi-item cart shares one thread instead of one per line item.
model OrderMessage {
  id        String    @id @default(cuid())
  orderId   String
  senderId  String
  body      String
  readAt    DateTime?
  createdAt DateTime  @default(now())

  order  Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sender User  @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}

// Outbound affiliate-link clicks, logged via a tiny click beacon so we can confirm
// our store/eBay links are actually being used — independent of each partner's own
// (slower, sometimes confusing) dashboard. One row per click; aggregate by day and
// retailer in queries. Used to verify eBay tracking is live.
model ClickEvent {
  id        String   @id @default(cuid())
  retailer  String // store key, e.g. "ebay", "cardbot", "tcgplayer"
  country   String // market the visitor was shopping (AU/NZ/US)
  kind      String   @default("single") // "single" | "sealed"
  // The page the click came FROM (e.g. "/card/lee-sin-centered-ogn-151-298"), so the
  // admin can see which card/product's link was clicked, not just the store. Null for
  // rows created before this existed.
  path      String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([retailer, createdAt])
}

// ── RiftCompare Marketplace ────────────────────────────────────────────────────
// A verified seller's storefront identity + shipping policy. One per user.
model SellerProfile {
  id                  String    @id @default(cuid())
  userId              String    @unique
  shopName            String
  bio                 String?
  // Market this seller serves; their listings inherit it (AU/NZ/US/UK).
  country             String    @default("AU")
  currency            String    @default("AUD")
  // Shipping: a flat postage estimate per order, free over a threshold (0 = never).
  shippingFlatCents   Int       @default(0)
  freeOverCents       Int       @default(0)
  shippingNote        String?
  // "Ships from" postcode — the origin side of the postcode-based shipping
  // estimate (see lib/shipping.ts). Optional: without it, checkout just falls
  // back to the flat rate above with no remote-area adjustment.
  postcode            String?
  handlingDays        Int       @default(2) // typical dispatch time in days
  // The platform's own official store ranks first in marketplace listings.
  isOfficial          Boolean   @default(false)
  // Payouts (Stripe Connect Express) — populated once the seller onboards.
  stripeAccountId     String?
  payoutsEnabled      Boolean   @default(false)
  // Admin trust & safety: a suspended seller's listings are force-PAUSED and they
  // cannot create new ones (see admin/marketplace).
  suspendedAt         DateTime?
  // Denormalised count of COMPLETED marketplace sales — drives the new-seller
  // listing/value caps (lib/marketplace.ts) and Phase-2 seller tiers.
  completedSalesCount Int       @default(0)
  // Explicit consent to the marketplace seller terms, stamped when the shop
  // profile is first saved with the "I agree" checkbox ticked.
  termsAcceptedAt     DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// A verified seller's listing of a single card for sale in our own marketplace.
// Surfaced in the card price comparison as the "RiftCompare Marketplace" source.
model MarketplaceListing {
  id         String   @id @default(cuid())
  sellerId   String
  cardId     String
  condition  String // NM, LP, MP, HP, DMG
  isFoil     Boolean  @default(false)
  priceCents Int
  quantity   Int      @default(1)
  currency   String   @default("AUD")
  country    String   @default("AU") // market this listing serves
  status     String   @default("ACTIVE") // ACTIVE, SOLD_OUT, PAUSED, REMOVED
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  seller User               @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  card   Card               @relation(fields: [cardId], references: [id], onDelete: Cascade)
  offers MarketplaceOffer[]

  @@index([cardId])
  @@index([sellerId])
  @@index([status])
  @@index([cardId, country, status])
  @@index([priceCents])
}

// A buyer's offer on a marketplace listing (eBay-style "Make an offer"). One
// PENDING offer per buyer+listing at a time; the seller accepts or declines,
// the buyer can cancel, and offers auto-expire after OFFER_EXPIRY_HOURS.
// ACCEPTED offers are bought at the offered price via the normal buy endpoint
// (which marks them COMPLETED).
model MarketplaceOffer {
  id          String    @id @default(cuid())
  listingId   String
  buyerId     String
  sellerId    String
  priceCents  Int // offered price PER COPY
  quantity    Int       @default(1)
  message     String? // optional note to the seller
  status      String    @default("PENDING") // PENDING|ACCEPTED|DECLINED|CANCELLED|EXPIRED|COMPLETED
  expiresAt   DateTime
  respondedAt DateTime?
  createdAt   DateTime  @default(now())

  listing MarketplaceListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  buyer   User               @relation("OffersMade", fields: [buyerId], references: [id], onDelete: Cascade)
  seller  User               @relation("OffersReceived", fields: [sellerId], references: [id], onDelete: Cascade)

  @@index([listingId, status])
  @@index([buyerId, status])
  @@index([sellerId, status])
}

// A buyer's review of a completed marketplace order — one per order. Aggregated
// into the seller's rating shown on listings and their storefront.
model MarketplaceReview {
  id        String   @id @default(cuid())
  orderId   String   @unique
  buyerId   String
  sellerId  String
  rating    Int // 1..5 (validated in app code)
  comment   String?
  createdAt DateTime @default(now())

  order  Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  buyer  User  @relation("ReviewsWritten", fields: [buyerId], references: [id], onDelete: Cascade)
  seller User  @relation("ReviewsReceived", fields: [sellerId], references: [id], onDelete: Cascade)

  @@index([sellerId, createdAt])
}

// Race-safe sequential counters for human-facing numbers (RC-100001 order numbers,
// RC-10001 support-ticket numbers). One row per counter `key`, incremented inside
// a `$queryRaw` UPDATE ... RETURNING so concurrent requests never collide — the repo
// pushes schema additively (`prisma db push`), so a real Postgres SEQUENCE isn't
// reachable without a raw-DDL migration channel; this table is the workaround.
// Rows are seeded lazily (upsert) the first time each key is used, starting at the
// offsets in lib/order-number.ts (orders @ 100000, tickets @ 10000).
model Counter {
  key   String @id
  value Int
}

// A buyer/seller support request. Emailed to SUPPORT_EMAIL on creation (see
// lib/support-email.ts) and worked from /admin/support. userId/orderId are soft
// links (no Prisma relation), matching Order.marketplaceListingId's convention,
// so a ticket never blocks on / cascades from user or order deletion.
model SupportTicket {
  id        String   @id @default(cuid())
  number    Int      @unique // RC-<n>, via Counter
  userId    String? // signed-in submitter, if any
  email     String
  name      String
  category  String   @default("OTHER") // ORDER | PAYMENT | ACCOUNT | SELLER | OTHER
  orderId   String? // set when opened via "Report a problem" on an order
  subject   String
  message   String
  status    String   @default("OPEN") // OPEN | IN_PROGRESS | RESOLVED | CLOSED
  adminNote String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([userId])
  @@index([orderId])
}

// A card a user owns in their personal collection ("My Cards"). One row per
// (user, card, condition, foil); quantity aggregates duplicates. Populated by the
// card scanner ("add to my cards") and editable from the profile.
model CollectionCard {
  id             String   @id @default(cuid())
  userId         String
  cardId         String
  condition      String   @default("NM") // NM, LP, MP, HP, DMG
  isFoil         Boolean  @default(false)
  quantity       Int      @default(1)
  // What the owner paid PER UNIT (market currency, cents). Optional — powers the
  // Premium cost-basis / profit-and-loss view. null = unknown (no P&L for that row).
  costBasisCents Int?
  note           String? // optional free-text (e.g. "graded PSA 9", "for trade")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@unique([userId, cardId, condition, isFoil])
  @@index([userId])
  @@index([cardId])
}

// Footer newsletter capture — "weekly Index summary in your inbox". The weekly
// digest itself is sent by /api/cron/newsletter (lib/newsletter.ts); this table
// is the direct-audience list.
// Opt-out list for PRODUCT ANNOUNCEMENTS sent to registered accounts (e.g. a
// set-release blast). Deliberately SEPARATE from NewsletterSubscriber:
//
// A registered user never opted into marketing — they made an account. So an
// announcement to them needs a working one-click opt-out, but enrolling them in
// NewsletterSubscriber to get one would ALSO sign them up to the weekly Friday
// digest they never asked for. This table is suppression-only: a row here means
// "never send this address another announcement". Absence means nothing (it is
// not a consent record), so it can never be mistaken for a subscription list.
//
// Keyed by email rather than userId so an opt-out survives account deletion and
// covers the same person if they re-register.
model AnnouncementOptOut {
  id         String    @id @default(cuid())
  email      String    @unique
  // Single-use-ish token embedded in the email's unsubscribe link. Generated per
  // recipient at send time and stored so the link keeps working afterwards.
  token      String    @unique
  createdAt  DateTime  @default(now())
  // Null until they actually click unsubscribe — the row is created at SEND time
  // (to mint the token), so this is what distinguishes "was emailed" from
  // "opted out". Only rows with a non-null optedOutAt suppress future sends.
  optedOutAt DateTime?

  @@index([optedOutAt])
}

model NewsletterSubscriber {
  id             String   @id @default(cuid())
  email          String   @unique
  market         String   @default("AU")
  // Where the subscriber signed up (footer | movers | countdown | …) so we can
  // attribute which surface converts. Null for rows created before this existed.
  source         String?
  createdAt      DateTime @default(now())
  // One-click unsubscribe token. Nullable so `db push` works on existing rows;
  // backfilled lazily the first time we email the subscriber.
  unsubToken     String?  @unique
  // Last digest edition delivered (e.g. "2026-W24") — makes the weekly send
  // idempotent: reruns and resumed partial runs only email who's still due.
  lastEditionKey String?
}
