{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "claude/*": false,
      "claude/**": false
    }
  },
  "crons": [
    {
      "path": "/api/cron/refresh-prices",
      "schedule": "0 18 * * *"
    },
    {
      "path": "/api/cron/price-alerts",
      "schedule": "30 18 * * *"
    },
    {
      "path": "/api/cron/newsletter",
      "schedule": "0 21 * * 5"
    },
    {
      "path": "/api/cron/user-digest",
      "schedule": "0 22 * * *"
    },
    {
      "path": "/api/cron/discord-daily",
      "schedule": "0 9 * * *"
    }
  ]
}
