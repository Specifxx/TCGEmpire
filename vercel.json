{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "**": false,
      "main": true,
      "claude/*": false,
      "claude/**": false,
      "reports": false,
      "forum": false,
      "ops-status": false,
      "social-packs": false
    }
  },
  "ignoreCommand": "bash scripts/vercel-ignore-build.sh",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.riftcompare.com"
        }
      ],
      "destination": "https://riftcompare.com/:path*",
      "permanent": true
    }
  ],
  "crons": [
    {
      "path": "/api/cron/stripe-reconcile",
      "schedule": "15 7 * * *"
    },
    {
      "path": "/api/cron/earnings-refresh",
      "schedule": "40 */3 * * *"
    }
  ]
}
