# Copy to .env and fill in. Never commit your real .env.

# Database.
#  - Local dev (default): SQLite file.
#      DATABASE_URL="file:./dev.db"
#  - Production (Vercel): a hosted Postgres connection string from Neon/Supabase.
#      DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
DATABASE_URL="file:./dev.db"

# Secret used to sign auth session cookies.
# Generate a strong one for production:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="change-me-in-production"

# --- eBay AU price source (optional). From developer.ebay.com (free). ---
# Until set, eBay prices are simply skipped.
# EBAY_CLIENT_ID="..."
# EBAY_CLIENT_SECRET="..."
# EBAY_AFFILIATE_CAMPAIGN="..."   # optional, eBay Partner Network campaign id

# eBay requires a Marketplace Account Deletion notification endpoint to enable
# production keys. Endpoint lives at /api/ebay/marketplace-deletion. Set the token
# below (also enter it in the eBay portal) and the exact endpoint URL.
# EBAY_VERIFICATION_TOKEN="riftcompare_ebay_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# EBAY_DELETION_ENDPOINT="https://riftcompare.com/api/ebay/marketplace-deletion"

# --- Scheduled job auth (Vercel Cron sets this automatically) ---
# Protects both daily crons: /api/cron/refresh-prices (price import) and
# /api/cron/price-alerts (wishlist price-drop emails). The latter needs RESEND_*
# below configured to actually deliver alerts.
# CRON_SECRET="..."

# --- Google AdSense (ad revenue) ---
# The publisher id (ca-pub-6842128782879909) is baked in as the code default in
# src/lib/ads.ts, so ads are LIVE without setting anything here. Only set this to
# override the account (e.g. a staging publisher id) or to disable ads (set to "").
# NEXT_PUBLIC_ADSENSE_CLIENT="ca-pub-6842128782879909"
#
# Optional manual ad-unit slot ids (AdSense → Ads → By ad unit → Display ad).
# Until set, those exact placements render nothing and Auto ads fill the page
# instead (enable Auto ads in the AdSense dashboard). Set these to take manual
# control of the specific high-value spots below.
# NEXT_PUBLIC_ADSENSE_SLOT_ARTICLE="1234567890"   # in-article units (blog/guides)
# NEXT_PUBLIC_ADSENSE_SLOT_BROWSE="0987654321"    # leaderboard on the browse grid
# NEXT_PUBLIC_ADSENSE_SLOT_CARD="1122334455"      # in-content on card detail pages

# --- Google AdMob (native app ad revenue) ---
# Used ONLY by the native iOS/Android app (see mobile/). These are the AdMob ad
# UNIT ids; the AdMob APP ids live in the native projects. Leave unset to serve
# Google's tap-safe TEST ads. Set your real banner units (per platform) to earn:
# NEXT_PUBLIC_ADMOB_BANNER_ANDROID="ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX"
# NEXT_PUBLIC_ADMOB_BANNER_IOS="ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX"
# Optional interstitials (not shown by default):
# NEXT_PUBLIC_ADMOB_INTERSTITIAL_ANDROID="ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX"
# NEXT_PUBLIC_ADMOB_INTERSTITIAL_IOS="ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX"

# --- Auto-affiliate network (monetises the 60+ store outbound links) ---
# eBay/Amazon/TCGplayer pay us directly; every OTHER store click earns nothing
# until routed through a link-monetisation network. Sovrn Commerce (formerly
# VigLink) is the default — a Skimlinks-style auto-affiliate with an easier
# acceptance bar. Sign up at sovrn.com → Commerce, add the site, then paste your
# Sovrn API key below and redeploy — links auto-monetise instantly. Empty = links
# pass through untouched (the current, safe default).
# AFFILIATE_NETWORK="sovrn"
# AFFILIATE_NETWORK_ID="<your Sovrn API key>"

# --- Stripe (marketplace card checkout, optional) ---
# Powers real card payments for the RiftCompare marketplace. Single-seller model, so
# plain Stripe Checkout (NOT Connect) — funds land in your Stripe account. INERT until
# STRIPE_SECRET_KEY is set (the marketplace falls back to the demo wallet).
#   1. dashboard.stripe.com → Developers → API keys → copy the Secret key.
#   2. Developers → Webhooks → add endpoint https://riftcompare.com/api/marketplace/stripe/webhook
#      (events: checkout.session.completed, .async_payment_succeeded, .expired,
#      .async_payment_failed) → copy the Signing secret into STRIPE_WEBHOOK_SECRET.
# STRIPE_SECRET_KEY="sk_live_..."          # or sk_test_... while testing
# STRIPE_WEBHOOK_SECRET="whsec_..."
# MARKETPLACE_RESERVE_MINUTES="30"         # optional; stock hold window (min 30)

# --- Shopify (official store backend, optional) ---
# Run the official store on Shopify and surface it inside RiftCompare: we read the
# catalog via the Storefront API and hand "Buy" off to Shopify's HOSTED checkout
# (Shopify handles cards, tax, fraud and carrier-calculated shipping). INERT until
# BOTH values below are set.
#   1. Shopify admin → Settings → Domains: copy your *.myshopify.com domain.
#   2. Shopify admin → Settings → Apps and sales channels → Develop apps →
#      create an app → Storefront API → install → copy the Storefront API access
#      token (grant unauthenticated_read_product_listings + unauthenticated_write_checkouts).
# SHOPIFY_STORE_DOMAIN="riftcompare.myshopify.com"
# SHOPIFY_STOREFRONT_TOKEN="..."
# SHOPIFY_API_VERSION="2024-10"   # optional; defaults to 2024-10

# --- AI market insights ("AI Tips" on cards, optional) ---
# Powers the funny, narrative buy/hold/wait take on each card. The VERDICT is always
# computed from our own price data (free); set ONE of the keys below to have an LLM
# write the prose. With no key, a funny rule-based fallback is used — the section
# always shows either way. One call per card per day (cached), so cost stays tiny.
#
# Option A — Google Gemini (FREE tier, no credit card). Get a key at
# aistudio.google.com → "Get API key". Recommended when on a $0 budget.
# GEMINI_API_KEY="AIza..."
# GEMINI_MODEL="gemini-2.0-flash"   # optional
#
# Option B — Anthropic Claude (paid; funniest). Key from console.anthropic.com.
# If BOTH are set, Claude wins.
# ANTHROPIC_API_KEY="sk-ant-..."
# AI_INSIGHT_MODEL="claude-opus-4-8"   # optional; use claude-haiku-4-5 to cut cost

# --- Sign in with Google (optional) ---
# Google Cloud Console → APIs & Services → Credentials → OAuth client (Web app).
# Authorised redirect URI: https://riftcompare.com/api/auth/oauth/google/callback
# GOOGLE_CLIENT_ID="...apps.googleusercontent.com"
# GOOGLE_CLIENT_SECRET="..."

# --- Sign in with Discord (optional) ---
# Discord Developer Portal → New Application → OAuth2.
# Redirect: https://riftcompare.com/api/auth/oauth/discord/callback   (scopes: identify, email)
# DISCORD_CLIENT_ID="..."
# DISCORD_CLIENT_SECRET="..."

# --- Transactional email for verification + password reset (optional) ---
# resend.com → API Keys. Verify your sending domain (riftcompare.com) for best
# deliverability; until then EMAIL_FROM can stay onboarding@resend.dev.
# RESEND_API_KEY="re_..."
# EMAIL_FROM="RiftCompare <noreply@riftcompare.com>"

# --- Weekly promo pack (free marketing automation, optional) ---
# Used by .github/workflows/weekly-promo.yml (set these as GitHub Actions secrets,
# not Vercel env vars). Generates a weekly price-movers digest: auto-posts it to
# the community Discord and emails a ready-to-paste Reddit/X promo pack.
# Discord: Server Settings → Integrations → Webhooks → New Webhook → Copy URL.
# DISCORD_WEBHOOK_URL="https://discord.com/api/webhooks/..."
# PROMO_EMAIL="you@example.com"      # promo-pack recipient (default: site contact email)
# PROMO_MARKET="AU"                  # AU | NZ | US | UK — market the digest prices
