# Copy to .env and fill in. Never commit your real .env.

# Database.
#  - Local dev (default): SQLite file.
#      DATABASE_URL="file:./dev.db"
#  - Production (Vercel): a hosted Postgres connection string from Neon/Supabase.
#      DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
DATABASE_URL="file:./dev.db"

# --- Split databases (production only; optional locally) ---------------------
# This project runs on TWO physical Neon Postgres databases so the write-heavy,
# ever-growing analytics tables can't eat the operational database's free-tier
# quota (see the header of src/lib/db-history.ts for the full rationale):
#
#   RM6  — the OPERATIONAL database (Card, RetailerPrice, User, Order, ...).
#          Resolved CURRENT-first in src/lib/db.ts:
#            RM6 || DATABASE_URL_2 || DATABASE_URL || RM5 || RM4 || RM3
#   HISTORY_DATABASE_URL_3 — the HISTORY database (PriceHistory, ClickEvent + a
#          stub Card table that exists only as PriceHistory's foreign-key parent).
#          Resolved CURRENT-first (not newest-first — see db-history.ts) in
#          src/lib/db-history.ts:
#            HISTORY_DATABASE_URL_3 || HISTORY_DATABASE_URL_2 || HISTORY_DATABASE_URL
#              || RH7 || RH6 || RH5 || HISTORY_DATABASE_URL_4 || DATABASE_URL
#
# Neither is needed for local dev — with both unset, everything shares
# DATABASE_URL and the app behaves identically (historyIsSplit === false).
#
# WHY THE NUMBERS KEEP GOING UP: each project is replaced when it exhausts its
# monthly Neon network-transfer allowance (or goes unreachable). Older names are
# kept in the chain purely as read-only migration sources. When you add the next
# one, grep the WHOLE repo for the previous name — the chain is duplicated by
# necessity in .github/workflows/*.yml and scripts/build-db-push.sh, which
# cannot import the TypeScript module, and a chain that silently stops at a dead
# project is how this repo has repeatedly lost time to an "unexplained" P1001.
# RM3="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
# RH6="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Secret used to sign auth session cookies.
# Generate a strong one for production:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="change-me-in-production"

# --- eBay AU price source (optional). From developer.ebay.com (free). ---
# Until set, eBay prices are simply skipped.
# EBAY_CLIENT_ID="..."
# EBAY_CLIENT_SECRET="..."
# EBAY_AFFILIATE_CAMPAIGN="..."   # optional, eBay Partner Network campaign id

# eBay requires a Marketplace Account Deletion notification endpoint to enable
# production keys. Endpoint lives at /api/ebay/marketplace-deletion. Set the token
# below (also enter it in the eBay portal) and the exact endpoint URL.
# EBAY_VERIFICATION_TOKEN="riftcompare_ebay_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# EBAY_DELETION_ENDPOINT="https://riftcompare.com/api/ebay/marketplace-deletion"

# --- Scheduled job auth (Vercel Cron sets this automatically) ---
# Protects the crons /api/cron/refresh-prices (price import) and
# /api/cron/price-alerts (wishlist price-drop emails), AND /api/revalidate
# (on-demand ISR regeneration after the price import — keeps DB egress down so the
# public pages can run a 24h cache fallback instead of a short timer). The
# price-alerts cron needs RESEND_* below configured to actually deliver alerts.
# NOTE: also add this SAME value as a GitHub Actions secret named CRON_SECRET so the
# refresh-prices workflow can call /api/revalidate after it imports.
# CRON_SECRET="..."

# ── Google AdSense (the web ad network) ───────────────────────────────────────
# THE SINGLE SOURCE OF TRUTH for the publisher id. Everything AdSense-related is
# derived from this one value (src/lib/adsense.ts):
#   • <meta name="google-adsense-account">   — site-ownership verification
#   • the pagead2 adsbygoogle.js loader src  — verification + Auto ads + consent
#   • every <ins class="adsbygoogle"> unit   — data-ad-client
#   • /ads.txt                               — "ca-" stripped ⇒ pub-…
#
# The id is PUBLIC (it ships in the page HTML) so it belongs here, not in a
# secret store. It must match /^ca-pub-\d{16}$/ or a PRODUCTION BUILD FAILS
# LOUDLY — deliberately, because shipping a wrong or missing id silently voids
# the AdSense review. Never hardcode it in a component again; scripts/adsense-
# guard.ts fails the build if a ca-pub- literal reappears in src/.
NEXT_PUBLIC_ADSENSE_CLIENT_ID="ca-pub-6842128782879909"

# Review mode. TRUE (the default) neutralises the surfaces an AdSense reviewer
# penalises: the homepage Premium teaser shows its real content instead of a
# locked count, blurred Premium previews render unblurred, and the AI-generated
# price-commentary module is hidden. Set to "false" AFTER the account is approved
# to restore all three. Set the NEXT_PUBLIC_ name — it is the only one client
# components can see; ADSENSE_REVIEW_MODE is accepted as a server-side alias.
#   NEVER gates the loader script or the ownership meta tag.
NEXT_PUBLIC_ADSENSE_REVIEW_MODE="true"

# Ad strategy — "auto" or "manual", MUTUALLY EXCLUSIVE by construction.
#   auto   (default) turn Auto ads ON in the AdSense console; this codebase
#                    renders no <ins> units of its own.
#   manual           turn Auto ads OFF in the console; this codebase places the
#                    units itself (see components/AdSlot.tsx).
# Running both at once stacks Google's placements on ours and produces the ad
# density that trips the Better Ads Standards half of the Publisher Policies.
NEXT_PUBLIC_AD_STRATEGY="auto"

# --- Google AdMob (native app ad revenue) ---
# Used ONLY by the native iOS/Android app (see mobile/). These are the AdMob ad
# UNIT ids; the AdMob APP ids live in the native projects. Leave unset to serve
# Google's tap-safe TEST ads. Set your real banner units (per platform) to earn:
# NEXT_PUBLIC_ADMOB_BANNER_ANDROID="ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX"
# NEXT_PUBLIC_ADMOB_BANNER_IOS="ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX"
# Optional interstitials (not shown by default):
# NEXT_PUBLIC_ADMOB_INTERSTITIAL_ANDROID="ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX"
# NEXT_PUBLIC_ADMOB_INTERSTITIAL_IOS="ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX"

# --- Per-store affiliate programs (the 60+ Shopify store outbound links) ---
# eBay/Amazon/TCGplayer pay us directly. Every OTHER store click earns nothing
# until you sign that store's own affiliate/referral program and register the URL
# rewrite in DIRECT_PROGRAMS (src/lib/affiliate.ts). No auto-affiliate network is
# used. Prioritise which stores to sign via the /admin/clicks leaderboard.

# --- Stripe (marketplace card checkout, optional) ---
# Powers real card payments for the RiftCompare marketplace. Single-seller model, so
# plain Stripe Checkout (NOT Connect) — funds land in your Stripe account. INERT until
# STRIPE_SECRET_KEY is set (the marketplace falls back to the demo wallet).
#   1. dashboard.stripe.com → Developers → API keys → copy the Secret key.
#   2. Developers → Webhooks → add endpoint https://riftcompare.com/api/marketplace/stripe/webhook
#      (events: checkout.session.completed, .async_payment_succeeded, .expired,
#      .async_payment_failed) → copy the Signing secret into STRIPE_WEBHOOK_SECRET.
# STRIPE_SECRET_KEY="sk_live_..."          # or sk_test_... while testing
# STRIPE_WEBHOOK_SECRET="whsec_..."
# MARKETPLACE_RESERVE_MINUTES="30"         # optional; stock hold window (min 30)

# --- Shopify (official store backend, optional) ---
# Run the official store on Shopify and surface it inside RiftCompare: we read the
# catalog via the Storefront API and hand "Buy" off to Shopify's HOSTED checkout
# (Shopify handles cards, tax, fraud and carrier-calculated shipping). INERT until
# BOTH values below are set.
#   1. Shopify admin → Settings → Domains: copy your *.myshopify.com domain.
#   2. Shopify admin → Settings → Apps and sales channels → Develop apps →
#      create an app → Storefront API → install → copy the Storefront API access
#      token (grant unauthenticated_read_product_listings + unauthenticated_write_checkouts).
# SHOPIFY_STORE_DOMAIN="riftcompare.myshopify.com"
# SHOPIFY_STOREFRONT_TOKEN="..."
# SHOPIFY_API_VERSION="2024-10"   # optional; defaults to 2024-10

# --- AI market insights ("AI Tips" on cards, optional) ---
# Powers the funny, narrative buy/hold/wait take on each card. The VERDICT is always
# computed from our own price data (free); set ONE of the keys below to have an LLM
# write the prose. With no key, a funny rule-based fallback is used — the section
# always shows either way. One call per card per day (cached), so cost stays tiny.
#
# Option A — Google Gemini (FREE tier, no credit card). Get a key at
# aistudio.google.com → "Get API key". Recommended when on a $0 budget.
# GEMINI_API_KEY="AIza..."
# GEMINI_MODEL="gemini-2.0-flash"   # optional
#
# Option B — Anthropic Claude (paid; funniest). Key from console.anthropic.com.
# If BOTH are set, Claude wins.
# ANTHROPIC_API_KEY="sk-ant-..."
# AI_INSIGHT_MODEL="claude-opus-4-8"   # optional; use claude-haiku-4-5 to cut cost

# --- Sign in with Google (optional) ---
# Google Cloud Console → APIs & Services → Credentials → OAuth client (Web app).
# Authorised redirect URI: https://riftcompare.com/api/auth/oauth/google/callback
# GOOGLE_CLIENT_ID="...apps.googleusercontent.com"
# GOOGLE_CLIENT_SECRET="..."

# --- Sign in with Discord (optional) ---
# Discord Developer Portal → New Application → OAuth2.
# Redirect: https://riftcompare.com/api/auth/oauth/discord/callback   (scopes: identify, email)
# DISCORD_CLIENT_ID="..."
# DISCORD_CLIENT_SECRET="..."

# --- Transactional email for verification + password reset (optional) ---
# resend.com → API Keys. Verify your sending domain (riftcompare.com) for best
# deliverability; until then EMAIL_FROM can stay onboarding@resend.dev.
# RESEND_API_KEY="re_..."
# EMAIL_FROM="RiftCompare <noreply@riftcompare.com>"

# --- Weekly digest to ALL registered accounts (optional, free) ---
# Sent via Brevo (app.brevo.com), NOT Resend, so this larger recurring audience
# never eats the Resend quota the emails above depend on. Free tier: 300
# emails/day forever, no credit card. Runs off /api/cron/user-digest, once a
# day (see vercel.json) — the daily cap means one weekly edition can take a
# few days to fully clear for a growing user base; see lib/user-digest.ts.
#   1. app.brevo.com → sign up free → left nav "SMTP & API" → API Keys → create one.
#   2. Same nav → Senders → add/verify the address you'll send from (can be the
#      same one as EMAIL_FROM above — Brevo verifies it separately from Resend).
# BREVO_API_KEY="xkeysib-..."

# --- Weekly promo pack (free marketing automation, optional) ---
# Used by .github/workflows/weekly-promo.yml (set these as GitHub Actions secrets,
# not Vercel env vars). Generates a weekly price-movers digest: auto-posts it to
# the community Discord and emails a ready-to-paste Reddit/X promo pack.
# Discord: Server Settings → Integrations → Webhooks → New Webhook → Copy URL.
# DISCORD_WEBHOOK_URL="https://discord.com/api/webhooks/..."
# PROMO_EMAIL="you@example.com"      # promo-pack recipient (default: site contact email)
# PROMO_MARKET="AU"                  # AU | NZ | US | UK — market the digest prices

# --- RiftCompare Premium (Stripe subscription, optional) ---
# Create a recurring Price in Stripe (e.g. A$5/month) and paste its id. The
# /premium subscribe button stays a waitlist CTA until this is set.
# STRIPE_PREMIUM_PRICE_ID="price_..."

# --- Discord bot (optional) ---
# discord.com/developers → New Application. Public key verifies interaction
# signatures (set in Vercel); app id + bot token are only needed locally to run
# scripts/register-discord-commands.ts. Interactions endpoint:
#   https://riftcompare.com/api/discord/interactions
# DISCORD_BOT_PUBLIC_KEY="..."
# DISCORD_APP_ID="..."
# DISCORD_BOT_TOKEN="..."

# --- IndexNow (Bing/Yandex/DuckDuckGo instant indexing) ---
# OPTIONAL override of the ping key (lib/indexnow.ts has a working default; the
# key is public by design — engines verify it via /indexnow.txt). Pings fire
# automatically from the daily crons, production only.
# INDEXNOW_KEY="b84a2a49fcda23c396d8b5320a45f218"
